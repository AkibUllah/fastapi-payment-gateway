# Application
APP_ENV=development
LOG_LEVEL=INFO

# Database (SQLite for local dev; Postgres in docker-compose)
DATABASE_URL=sqlite:///./gateway.db
# DATABASE_URL=postgresql+psycopg://gateway:gateway@db:5432/gateway

# Provider webhook secrets (sandbox values; replace per environment)
BKASH_WEBHOOK_SECRET=bkash-sandbox-secret
SSLCOMMERZ_WEBHOOK_SECRET=sslcz-sandbox-secret
STRIPE_WEBHOOK_SECRET=whsec_sandbox_secret

# Outgoing merchant webhooks
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300

# Idempotency keys are retained for this long
IDEMPOTENCY_TTL_HOURS=24
