# Application
APP_ENV=development
LOG_LEVEL=INFO

# Database (SQLite for local dev; Postgres in docker-compose)
DATABASE_URL=sqlite:///./gateway.db
# DATABASE_URL=postgresql+psycopg://gateway:gateway@db:5432/gateway

# Provider webhook secrets (sandbox values; replace per environment)
BKASH_WEBHOOK_SECRET=bkash-sandbox-secret
SSLCOMMERZ_WEBHOOK_SECRET=sslcz-sandbox-secret
STRIPE_WEBHOOK_SECRET=whsec_sandbox_secret

# Outgoing merchant webhooks
WEBHOOK_TIMEOUT_SECONDS=5
# Attempts made right after the request, before the retry schedule takes over
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
# Seconds between scheduled retries; empty disables them. Run the webhook worker to send them.
WEBHOOK_RETRY_SCHEDULE=60,300,1800,7200,43200
# Each step varies by this fraction, so a recovering merchant is not hit all at once
WEBHOOK_RETRY_JITTER=0.1
# How long a worker owns a delivery; a crashed worker's rows return after this.
# Must be at least 4 x WEBHOOK_TIMEOUT_SECONDS.
WEBHOOK_LEASE_SECONDS=60
WEBHOOK_DISPATCH_POLL_SECONDS=5
WEBHOOK_DISPATCH_BATCH_SIZE=50

# Idempotency keys are retained for this long
IDEMPOTENCY_TTL_HOURS=24
# How long a request holds its Idempotency-Key while it runs (keep above the slowest provider call)
IDEMPOTENCY_LOCK_SECONDS=60
